# Core
CLIPPER_WORKDIR=./data
MAX_CLIPS=8
AUDIO_NORMALIZE=1
STAGE_CACHE=1

# Hardware auto-tuning (recommended). On an RTX A4000, Clipper will prefer
# faster-whisper large-v3 on CUDA and NVENC when your local installs support them.
AUTO_HARDWARE_PROFILE=1
# Leave these blank to use the detected hardware profile, or set them explicitly.
WHISPER_MODEL=
WHISPER_DEVICE=
WHISPER_BATCH_SIZE=
FFMPEG_ENCODER=
RENDER_WORKERS=

# Automatic edit intelligence
SMART_CUT=1
REMOVE_FILLERS=1
PUNCH_INS=1
HOOK_OVERLAY=1
CAPTION_PRESET=karaoke
BRAND_KIT=
BACKGROUND_MUSIC=

# Optional Gemini ranking / visual planning / metadata
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transcript-aware B-roll. commons = pulled reusable imagery; diffusers = local generation;
# auto = Commons first then local generation if DIFFUSION_MODEL is set; none = disabled.
VISUAL_PROVIDER=commons
DIFFUSION_MODEL=

# Social-link ingest for content you own. Browser cookies can expose a cleaner/original
# source when the platform makes it available to the account owner.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# Firebase bridge
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_POLL_SECONDS=8
FIREBASE_WORKER_ID=

# Optional Upload-Post publishing
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
