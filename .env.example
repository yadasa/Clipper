# Core
CLIPPER_WORKDIR=./data
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_BATCH_SIZE=8
FFMPEG_ENCODER=auto
AUDIO_NORMALIZE=1
MAX_CLIPS=8

# Optional Gemini ranking / visual planning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local image generation
VISUAL_PROVIDER=none
DIFFUSION_MODEL=

# Social-link ingest for content you own
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# Firebase bridge
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_POLL_SECONDS=8
FIREBASE_WORKER_ID=

# Optional Upload-Post publishing
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
