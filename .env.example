# Core
CLIPPER_WORKDIR=./data
MAX_CLIPS=8
AUDIO_NORMALIZE=1
STAGE_CACHE=1

# Auto is the recommended one-click creator workflow. It builds a synced precomp,
# transcribes the authoritative timeline, creates one globally cleaned master,
# selects/stitches coherent stories, adapts edit density, captions last, and runs QA.
AUTOMATION_MODE=auto
AUTO_GLOBAL_CLEANUP=1
AUTO_STORY_STITCH=1
AUTO_VISUAL_INTENSITY=1
AUTO_QUALITY_GATE=1
AUTO_SYNC_REFINE_CONFIDENCE=0.24
AUTO_CLEANUP_MAX_REMOVED_RATIO=0.58
AUTO_MIN_CLIP_SECONDS=15
AUTO_MAX_CLIP_SECONDS=55

# Local FastAPI upload guard. Large creator recordings are allowed, but requests
# are still bounded and staged atomically rather than copied without a limit.
LOCAL_MAX_UPLOAD_MB=8192

# Hardware auto-tuning (recommended). On an RTX A4000, Clipper will prefer
# faster-whisper large-v3 on CUDA and NVENC when your local installs support them.
AUTO_HARDWARE_PROFILE=1
# Leave these blank to use the detected hardware profile, or set them explicitly.
WHISPER_MODEL=
WHISPER_DEVICE=
WHISPER_BATCH_SIZE=
FFMPEG_ENCODER=
RENDER_WORKERS=

# Automatic edit intelligence. In auto mode silence/filler cleanup is applied once
# to the clean master before selection; these values remain useful for manual mode
# and as feature allow/deny switches for auto decisions.
SMART_CUT=1
REMOVE_FILLERS=1
PUNCH_INS=1
HOOK_OVERLAY=1
CAPTION_PRESET=karaoke
BRAND_KIT=
BACKGROUND_MUSIC=

# Optional Gemini ranking / B-roll planning / metadata
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Context-aware B-roll. Providers are tried in this exact order; unavailable
# providers are skipped. Local library and stock videos are preferred before
# still-image/generated fallbacks.
BROLL_AUTO_INSERT=1
BROLL_PROVIDERS=local,pexels,pixabay,commons,diffusers
BROLL_LIBRARY=
BROLL_MAX_CUES=6
BROLL_MIN_RELEVANCE=0.30
BROLL_MAX_DOWNLOAD_MB=80
BROLL_SEARCH_CACHE_HOURS=24
PEXELS_API_KEY=
PIXABAY_API_KEY=
DIFFUSION_MODEL=

# Backward-compatible coarse visual switch:
# auto = provider waterfall; commons/diffusers = only that legacy provider; none = disabled.
VISUAL_PROVIDER=auto

# Social-link ingest for content you own. Browser cookies can expose a cleaner/original
# source when the platform makes it available to the account owner.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# Firebase bridge
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_POLL_SECONDS=8
FIREBASE_WORKER_ID=

# Optional Upload-Post publishing
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=